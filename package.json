{
	"type": "module",
  "version": "0.1.0",
	"scripts": {
		"build": "spicetify-kit build --no-check module",
		"dev": "spicetify-kit dev module",
		"test": "node --test \"test/*.test.mts\"",
		"check": "tsc -p tsconfig.json && tsc -p tsconfig.node.json && spicetify-kit check module",
		"evaluate": "node scripts/evaluate.mts"
	},
	"devDependencies": {
		"@spicetify/kit": "^0.3.1",
		"@types/node": "^22",
		"@types/react": "^18",
		"@types/react-dom": "^18",
		"onnxruntime-node": "1.30.0",
		"onnxruntime-web": "1.30.0",
		"typescript": "^7"
	}
}
